{
  "manifest_version": 3,
  "name": "GrantAssistant — SciENcv Assistant",
  "version": "1.0.0",
  "description": "AI-powered trimming and citation selection for NIH SciENcv. Compliance audit trail included.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.ncbi.nlm.nih.gov/labs/sciencv/*",
    "https://www.ncbi.nlm.nih.gov/myncbi/*",
    "https://grant-assistant-omega.vercel.app/*"
  ],
  "icons": {
    "16":  "icon16.png",
    "32":  "icon32.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ncbi.nlm.nih.gov/labs/sciencv/*",
        "https://www.ncbi.nlm.nih.gov/myncbi/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": [
        "https://grant-assistant-omega.vercel.app/auth/extension-login*"
      ],
      "js": ["auth-listener.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "32":  "icon32.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  }
}
